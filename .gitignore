# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the documented template (see README) tracked in the repo
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent/editor lock artifacts (never commit local session/process info)
.claude/*.lock


# Playwright artifacts
/test-results/
/playwright-report/
/blob-report/

# Lighthouse CI artifacts
.lighthouseci/

# Radar private-platform staging (ADR-002) — never commit to the public repo
/data-platform/staging/
# Generated platform artifacts (canonical.json / seed.sql / rbi-*.json) —
# produced by npm run platform:import / platform:ingest-rbi
/data-platform/out/
# Concierge-sales tracker (real prospect data — local only, Phase 6)
/docs/sales/prospects.csv
