# Canonical site URL (used for sitemap, SEO metadata, and JSON-LD structured data)
# Replace this placeholder with the production origin before deploying.
SITE_URL=https://fintech-atlas.example.com

# Optional: cookieless analytics site id (Plausible-compatible).
# When unset, no analytics script is loaded and events are no-ops.
# When set, the CSP generator automatically permits plausible.io.
# NEXT_PUBLIC_ANALYTICS_DOMAIN=fintech-atlas.example.com

# Optional: third-party form endpoint for the newsletter opt-in (Phase 3).
# Buttondown, ConvertKit, Mailchimp, Formspree, etc. When unset, the newsletter
# stores the email locally on the device with an honest "not connected" notice.
# When set, the CSP generator automatically permits the endpoint's origin.
# NEXT_PUBLIC_NEWSLETTER_FORM_ACTION=https://buttondown.com/api/emails/add-subscriber

# Optional: third-party form endpoint for a Pro / partner waitlist
# (Formspree, Getform, Buttondown, etc.). When unset, waitlist UI stays hidden.
# NEXT_PUBLIC_WAITLIST_ENDPOINT=https://formspree.io/f/your-form-id

